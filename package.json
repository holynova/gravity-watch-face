{
  "name": "gravity-watch-face",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Mobile-first 3D physics interactive watch face powered by device motion sensors, Three.js PBR, and cannon-es.",
  "scripts": {
    "dev": "vite --host --port 5174",
    "dev:https": "HTTPS=1 vite --host --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4174",
    "typecheck": "tsc --noEmit",
    "deploy:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wrangler": "^4.128.0"
  }
}
